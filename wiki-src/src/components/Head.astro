---
// Starlight's default <head>, plus JSON-LD structured data for every wiki page:
// - every page: WebPage (part of the osprey.build WebSite) + BreadcrumbList
// - the wiki home is also marked as a CollectionPage
// Data comes only from each page's own title and description.
import Default from "@astrojs/starlight/components/Head.astro";

const route = Astro.locals.starlightRoute;
const { entry } = route;
const site = "https://osprey.build";
const url = new URL(Astro.url.pathname, site).href;
const title = entry.data.title;
const description = entry.data.description;
const isHome = route.id === "" || route.id === "index";
const isNotFound = Astro.url.pathname.replace(/\/$/, "").endsWith("/404");
// Preserve authored descriptions. Only missing descriptions receive a topic-specific fallback.
const effectiveDescription = description || `${title}: documentation in the official Osprey Minecraft server wiki.`;
for (const element of route.head) {
  if (element.tag === "title" && isHome) element.content = "Osprey Wiki";
  if (element.tag === "meta" && element.attrs
    && (element.attrs.name === "description" || element.attrs.property === "og:description")) {
    element.attrs.content = effectiveDescription;
  }
  if (isHome && element.tag === "meta" && element.attrs?.property === "og:type") {
    element.attrs.content = "website";
  }
}

const crumbs = [
  { name: "Osprey", item: `${site}/` },
  { name: "Wiki", item: `${site}/wiki/` },
];
if (!isHome) crumbs.push({ name: title, item: url });
const breadcrumb = {
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: c.item })),
};

const website = {
  "@type": "WebSite",
  "@id": `${site}/#website`,
  name: "Osprey",
  url: `${site}/`,
};

const page: Record<string, unknown> = {
  "@type": isHome ? ["WebPage", "CollectionPage"] : "WebPage",
  "@id": `${url}#webpage`,
  url,
  name: isHome ? "Osprey Wiki" : `${title} | Osprey Wiki`,
  headline: title,
  inLanguage: "en",
  isPartOf: { "@id": `${site}/#website` },
  breadcrumb: { "@id": `${url}#breadcrumb` },
  image: `${site}/assets/brand/og-image.png`,
  publisher: { "@id": `${site}/#org` },
};
page.description = effectiveDescription;

const organization = {
  "@type": "Organization",
  "@id": `${site}/#org`,
  name: "Osprey",
  url: `${site}/`,
  logo: `${site}/assets/brand/osprey-mark-light.png`,
};

const graph = {
  "@context": "https://schema.org",
  "@graph": [organization, website, page, { ...breadcrumb, "@id": `${url}#breadcrumb` }],
};
const json = JSON.stringify(graph).replace(/</g, "\\u003c");
---
<Default />
<meta name="robots" content={isNotFound ? "noindex, follow" : "index, follow, max-image-preview:large"} />
<link rel="alternate" type="text/plain" href="/wiki/llms.txt" title="Osprey Wiki page directory" />
<link rel="alternate" type="text/plain" href="/wiki/llms-full.txt" title="Osprey Wiki article text" />
{!isNotFound && <script type="application/ld+json" is:inline set:html={json} />}
